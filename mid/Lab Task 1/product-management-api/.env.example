NODE_ENV="development"
NODE_DB_ENV="development"
JWT_BEARER_SECRET="change-me-sample-secret"
PORT=5001

DB_CLIENT="postgres"
DB_DATABASE="product_db"
DB_USER="postgres"
DB_PASSWORD="your_postgres_password_here"
