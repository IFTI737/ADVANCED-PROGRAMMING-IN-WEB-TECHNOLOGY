# Core Environment Settings
NODE_ENV=development
NODE_DB_ENV=development
JWT_BEARER_SECRET="change-me-sample-secret"
PORT=5001

# Database Configuration (PostgreSQL)
DB_CLIENT="postgres"
DB_DATABASE="product_db"
DB_USER="postgres"
DB_PASSWORD="your_postgres_password_here"
DB_HOST="localhost"
DB_PORT="5432"

# Redis (not needed for this lab, leave as is)
REDIS_PORT=6379
REDIS_HOST="localhost"
REDIS_URL=

# Email (not used in this lab; sample values so the config check passes)
MAILER_HOST="smtp.example.com"
MAILER_PORT=587
MAILER_SECURE=false
MAILER_USER="sample@example.com"
MAILER_PASSWORD="sample-password"
MAILER_FROM="sample@example.com"
